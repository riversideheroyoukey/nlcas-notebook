# Python
__pycache__/
*.py[cod]
*.pyo
.venv/

# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Debug / temp artifacts
debug_preprocessed.png
.coverage
append_coverage.py
scratch/
scratch_vector_calc.py

# Julia build artifacts
notebook/runtime/sysimage.dylib
notebook/runtime/*.dylib
notebook/runtime/*.so

# KaTeX assets (downloaded at runtime by katex_utils.py)
ui/static/lib/katex/
ui/static/lib/html2canvas.min.js

# sessions/ is a pure WORKSPACE (session saves, autosave rotation, TeX-export
# staging) — nothing durable lives here.  Canonical scenario examples are in
# domains/*/examples/; durable evaluation logs in docs/evaluations/.
sessions/

# Numeric layer (N-1): dedicated interpreter venv. Per-execution run dirs
# live under sessions/<stem>_numeric/ (anchored to the saved session JSON),
# already covered by the sessions/ ignore rule above.
.venv-numeric/

# Paper-writing working files (drafts, screenshots, scenario runs)
docs/temp/

# Stray large binaries that don't belong in the repo (e.g. a Windows install
# ISO dropped in the project root for VM setup convenience — never commit).
*.iso

# Windows numeric sandbox (G-4): DPAPI-encrypted password for the dedicated
# "numeric" local account, generated by scripts/setup_windows_numeric_sandbox.ps1.
# Decryptable only by the same Windows account on the same machine, but a
# secret regardless — never commit.
.numeric_account_pw.dat

# Official upstream manuals kept locally for reference (Maxima / Julia /
# QuantumAlgebra).  Third-party documents, ~26 MB, not this project's work —
# they belong beside the repo, not in it.  `backends/maxima.function_families.json`
# cites the Maxima manual as the SOURCE its list was extracted from; the derived
# list is tracked, the manual is not.
docs/misc/

# Public distribution staging (contains copies, archives and inspection reports)
public_release/

# Local credentials and environment overrides
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Conference working-data folders, wherever placed in the workspace
**/[Aa][Pp][Ii][Ee][Mm][Ss]*/
