    "S4": {
      "step_id": "S4",
      "kind": "manual_note",
      "branch_id": "main",
      "parent_step_ids": [
        "S3"
      ],
      "timestamp": "2026-09-25T11:58:55.822425Z",
      "user_text": "$n$ 拠点分の需要を1つの中央倉庫にプールした場合を考える。独立同分布の仮定のもとで分散が加法的に効くため、実質的なリードタイム項が $L$ から $nL$ に置き換わる。この置き換えを元の式に代入する（元の式自体は単独拠点の場合として引き続き参照できる）。",
      "visible_action": "メモ",
      "operation": null,
      "operation_args": {},
      "backend": null,
      "rendered_command": null,
      "show_command_to_user": false,
      "input_refs": [],
      "output_refs": [],
      "state_affecting": false,
      "status": "success",
      "user_confirmation": null,
      "route": null
    },
    "S5": {
      "step_id": "S5",
      "kind": "user_input",
      "branch_id": "main",
      "parent_step_ids": [
        "S4"
      ],
      "timestamp": "2026-09-25T11:58:55.822470Z",
      "user_text": "E1 の L に n * L を代入して",
      "visible_action": "利用者入力",
      "operation": null,
      "operation_args": {},
      "backend": null,
      "rendered_command": null,
      "show_command_to_user": false,
      "input_refs": [],
      "output_refs": [],
      "state_affecting": false,
      "status": "success",
      "user_confirmation": null,
      "route": null
    },
    "S6": {
      "step_id": "S6",
      "kind": "cas_operation",
      "branch_id": "main",
      "parent_step_ids": [
        "S4"
      ],
      "timestamp": "2026-09-25T11:58:55.824941Z",
      "user_text": null,
      "visible_action": "E1 の L → L n",
      "operation": "substitute",
      "operation_args": {
        "expr": "E1",
        "lhs": "L",
        "rhs": "n * L"
      },
      "backend": "maxima",
      "rendered_command": "rhs(block([SS], block([L], ratsimp(subst(L=n * L,SS=z * sigma * sqrt(L))))))",
      "show_command_to_user": false,
      "input_refs": [
        "E1"
      ],
      "output_refs": [
        "E2"
      ],
      "state_affecting": true,
      "status": "success",
      "user_confirmation": null,
      "route": "substitute_into"
    },
    "S7": {
      "step_id": "S7",
      "kind": "manual_note",
      "branch_id": "main",
      "parent_step_ids": [
        "S6"
      ],
      "timestamp": "2026-09-25T11:58:55.825651Z",
      "user_text": "プールした場合の安全在庫と、$n$ 拠点それぞれの安全在庫の合計（元の式の $n$ 倍）との比を取り、リスクプーリングの効果（平方根則 $1/\\sqrt n$ になるはず）を確認する。",
      "visible_action": "メモ",
      "operation": null,
      "operation_args": {},
      "backend": null,
      "rendered_command": null,
      "show_command_to_user": false,
      "input_refs": [],
      "output_refs": [],
      "state_affecting": false,
      "status": "success",
      "user_confirmation": null,
      "route": null
    },
