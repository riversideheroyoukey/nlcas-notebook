      "kind": "cas_operation",
      "branch_id": "main",
      "parent_step_ids": [
        "S4"
      ],
      "timestamp": "2026-09-25T11:58:55.909592Z",
      "user_text": null,
      "visible_action": "L → L n in E1",
      "operation": "substitute",
      "operation_args": {
        "expr": "E1",
        "lhs": "L",
        "rhs": "n * L"
      },
      "backend": "maxima",
      "rendered_command": "rhs(block([SS], block([L], ratsimp(subst(L=n * L,SS=z * sigma * sqrt(L))))))",
      "show_command_to_user": false,
      "input_refs": [
        "E1"
      ],
      "output_refs": [
        "E2"
      ],
      "state_affecting": true,
      "status": "success",
      "user_confirmation": null,
