      "backend": "julia_full",
      "rendered_command": "_nb_E7 = (let\n    @variables nbA_g_k_u nbA_g__k_d nbA_gD_k_u nbA_gD__k_d nbA_c_k_u nbA_c__k_d nbA_cD_k_u nbA_cD__k_d\n    _sols = Symbolics.simplify.(Symbolics.solve_for([nbA_g_k_u ~ u * nbA_c_k_u - v * nbA_cD__k_d, nbA_g__k_d ~ u * nbA_c__k_d + v * nbA_cD_k_u, nbA_gD_k_u ~ u * nbA_cD_k_u - v * nbA_c__k_d, nbA_gD__k_d ~ u * nbA_cD__k_d + v * nbA_c_k_u], [nbA_c_k_u, nbA_c__k_d, nbA_cD_k_u, nbA_cD__k_d]))\n    replace(join([\"c(k,u)\", \"c(-k,d)\", \"c'(k,u)\", \"c'(-k,d)\"] .* \" = \" .* string.(_sols), \", \"), \"nbA_g_k_u\" => \"g(k,u)\", \"nbA_c_k_u\" => \"c(k,u)\", \"nbA_cD__k_d\" => \"c'(-k,d)\", \"nbA_g__k_d\" => \"g(-k,d)\", \"nbA_c__k_d\" => \"c(-k,d)\", \"nbA_cD_k_u\" => \"c'(k,u)\", \"nbA_gD_k_u\" => \"g'(k,u)\", \"nbA_gD__k_d\" => \"g'(-k,d)\")\nend)",
