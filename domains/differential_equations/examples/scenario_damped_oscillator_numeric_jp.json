    "S19": {
      "step_id": "S19",
      "kind": "manual_note",
      "branch_id": "main",
      "parent_step_ids": [
        "S18"
      ],
      "timestamp": "2026-09-25T11:57:19.043001Z",
      "user_text": "特性方程式は $r$ の２次式（$ar^2+br+c=0$ で $a=1,\\ b=2\\gamma,\\ c=\\omega_0^2$）なので、以下の判別式 $b^2-4ac=(2\\gamma)^2-4\\omega_0^2$ を得る。ここでは以降の議論を「正なら不足減衰」という自然な形にするため、この符号を反転させた量 $D=4\\omega_0^2-(2\\gamma)^2=-(b^2-4ac)$ を定義する。",
      "visible_action": "メモ",
      "operation": null,
      "operation_args": {},
      "backend": null,
      "rendered_command": null,
      "show_command_to_user": false,
      "input_refs": [],
      "output_refs": [],
      "state_affecting": false,
      "status": "success",
      "user_confirmation": null,
      "route": null
    },
    "S20": {
      "step_id": "S20",
      "kind": "user_input",
      "branch_id": "main",
      "parent_step_ids": [
        "S19"
      ],
      "timestamp": "2026-09-25T11:57:19.043037Z",
      "user_text": "D = 4 \\omega_0^2 - (2 \\gamma)^2",
      "visible_action": "利用者入力",
      "operation": null,
      "operation_args": {},
      "backend": null,
      "rendered_command": null,
      "show_command_to_user": false,
      "input_refs": [],
