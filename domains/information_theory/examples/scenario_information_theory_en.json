      "kind": "user_input",
      "branch_id": "main",
      "parent_step_ids": [
        "S18"
      ],
      "timestamp": "2026-09-25T11:58:10.961128Z",
      "user_text": "D = p\\log \\frac{p}{q} + (1-p)\\log \\frac{1-p}{1-q}",
      "visible_action": "User input",
      "operation": null,
      "operation_args": {},
      "backend": null,
